// Obras Gestão — construção civil + arquitetura. Banco: PostgreSQL (Docker/nuvem).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  SUPER_ADMIN
  ADMIN
  GESTOR
  USUARIO
}

/// Escritório/tenant. Cada organização tem dados isolados e sua própria marca (nome + logo).
model Organizacao {
  id       String   @id @default(cuid())
  nome     String
  slug     String   @unique
  logoData String?
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now())

  /// Fim do período de teste (demo). NULL = conta permanente, sem prazo.
  /// Depois desta data o acesso é bloqueado até o super-admin estender ou liberar.
  trialAte DateTime?

  // Plano e limites (definidos pelo super-admin). NULL em limite = ilimitado.
  plano                 String  @default("Grátis")
  limiteProjetos        Int?
  limiteUsuarios        Int?
  limiteArmazenamentoMB Int?

  // Comercial (só o super-admin vê): cobrança, contato e notas internas.
  statusPagamento   StatusPagamento @default(EM_DIA)
  precoMensal       Float? // valor mensal cobrado deste escritório (base do MRR)
  proximoVencimento DateTime?
  notasInternas     String?
  contatoNome       String?
  contatoTelefone   String?
  contatoEmail      String?

  usuarios      User[]
  clientes      Cliente[]
  projetos      Projeto[]
  profissionais Profissional[]
}

enum StatusPagamento {
  EM_DIA
  PENDENTE
  ISENTO
}

/// Link público de acompanhamento da obra, entregue ao cliente do escritório.
/// Acesso por token secreto (sem login). Tudo aqui é OPT-IN: o portal mostra
/// apenas o que as flags liberam, e nunca dados internos (custos, equipe, notas).
model PortalCliente {
  id             String    @id @default(cuid())
  token          String    @unique
  ativo          Boolean   @default(true)
  expiraEm       DateTime? // null = sem prazo
  visitas        Int       @default(0)
  ultimoAcessoEm DateTime?
  criadoEm       DateTime  @default(now())

  // O que o cliente enxerga
  mostrarCronograma Boolean @default(true)
  mostrarDiario     Boolean @default(true)
  mostrarDocumentos Boolean @default(true)
  mostrarAprovacoes Boolean @default(true)

  organizacaoId String

  // Um link por projeto (regenerar o token reaproveita o registro).
  projetoId String  @unique
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([organizacaoId])
}

/// Histórico de acessos (logins) dos usuários — para o painel de uso do super-admin.
/// Denormalizado (nome/e-mail/org) para sobreviver à exclusão de usuário/escritório.
model AcessoLog {
  id            String   @id @default(cuid())
  userId        String?
  userNome      String
  userEmail     String
  organizacaoId String?
  orgNome       String?
  ip            String?
  criadoEm      DateTime @default(now())

  @@index([organizacaoId])
  @@index([criadoEm])
}

/// Registro de auditoria das ações do super-admin sobre os escritórios.
/// Sem FK para a organização — o log deve sobreviver à exclusão do escritório.
model AdminLog {
  id            String   @id @default(cuid())
  acao          String // "impersonou", "redefiniu_senha", "ativou", "definiu_plano"...
  detalhe       String?
  organizacaoId String?
  orgNome       String?
  atorEmail     String // super-admin que executou
  criadoEm      DateTime @default(now())

  @@index([organizacaoId])
  @@index([criadoEm])
}

enum TipoCliente {
  PF
  PJ
}

enum StatusProjeto {
  PLANEJAMENTO
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
}

enum StatusSubEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum StatusItemRDO {
  OK
  ATENCAO
  PROBLEMA
}

model User {
  id                 String   @id @default(cuid())
  nome               String
  email              String   @unique
  senhaHash          String
  papel              Papel    @default(USUARIO)
  ativo              Boolean   @default(true)
  recebeNotificacoes Boolean   @default(false)
  criadoEm           DateTime  @default(now())
  ultimoAcessoEm     DateTime?

  // Tenant: SUPER_ADMIN (dono da plataforma) não pertence a nenhuma organização.
  organizacaoId String?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  projetosResponsavel Projeto[]          @relation("ProjetoResp")
  rdosCriados         DiarioObra[]       @relation("RDOCriados")
  docsEnviados        Documento[]        @relation("DocEnviados")
  aprovacoesResp      Aprovacao[]        @relation("AprovacaoResp")
  horasApontadas      ApontamentoHoras[] @relation("HorasUser")

  @@index([organizacaoId])
}

model Cliente {
  id          String      @id @default(cuid())
  nome        String
  tipo        TipoCliente @default(PF)
  cpfCnpj     String?
  telefone    String?
  email       String?
  endereco    String?
  observacoes String?
  criadoEm    DateTime    @default(now())

  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  projetos Projeto[]

  @@index([organizacaoId])
}

/// Núcleo do app: um projeto/obra (construção ou projeto arquitetônico).
model Projeto {
  id             String        @id @default(cuid())
  titulo         String
  tipo           String        @default("Residencial")
  descricao      String?
  endereco       String?
  areaM2         Float?
  status         StatusProjeto @default(PLANEJAMENTO)
  dataInicioPrev DateTime
  dataFimPrev    DateTime
  valorContrato  Float?
  criadoEm       DateTime      @default(now())

  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  responsavelId String?
  responsavel   User?   @relation("ProjetoResp", fields: [responsavelId], references: [id], onDelete: SetNull)

  etapas       EtapaProjeto[]
  diarios      DiarioObra[]
  orcamentos   Orcamento[]
  lancamentos  LancamentoFinanceiro[]
  documentos   Documento[]
  alocacoes    AlocacaoProjeto[]
  tarefasEquipe TarefaProfissional[]
  aprovacoes   Aprovacao[]
  horas        ApontamentoHoras[]
  portal       PortalCliente?

  @@index([clienteId])
  @@index([organizacaoId])
}

model EtapaProjeto {
  id         String    @id @default(cuid())
  nome       String
  inicioPrev DateTime
  fimPrev    DateTime
  inicioReal DateTime?
  fimReal    DateTime?
  progresso  Int       @default(0) // 0-100 (automático quando há sub-etapas)
  ordem      Int       @default(0)

  organizacaoId String // herdado do projeto (escopo de tenant)

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  subEtapas SubEtapa[]
  horas     ApontamentoHoras[]

  @@index([organizacaoId])
}

/// Sub-tarefa (checklist) de uma etapa; o % da etapa é calculado por estas.
model SubEtapa {
  id          String         @id @default(cuid())
  titulo      String
  descricao   String?
  status      StatusSubEtapa @default(PENDENTE)
  ordem       Int            @default(0)
  concluidaEm DateTime?
  criadoEm    DateTime       @default(now())

  organizacaoId String

  etapaId String
  etapa   EtapaProjeto @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  responsavelProfId String?
  responsavelProf   Profissional? @relation("SubEtapaResp", fields: [responsavelProfId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
}

/// Diário de Obra (RDO): registro da situação no canteiro, preenchido no celular.
model DiarioObra {
  id          String   @id @default(cuid())
  data        DateTime
  clima       String?
  maoDeObra   String?
  atividades  String?
  ocorrencias String?
  criadoEm    DateTime @default(now())

  organizacaoId String

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  criadoPorId String?
  criadoPor   User?   @relation("RDOCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)

  itens ItemChecklistRDO[]
  fotos FotoRDO[]

  @@index([projetoId, data])
  @@index([organizacaoId])
}

/// Item do checklist de situação do RDO (ex.: "Fundação", "Segurança/EPI").
model ItemChecklistRDO {
  id         String        @id @default(cuid())
  titulo     String
  status     StatusItemRDO @default(OK)
  observacao String?
  ordem      Int           @default(0)

  diarioId String
  diario   DiarioObra @relation(fields: [diarioId], references: [id], onDelete: Cascade)
}

model FotoRDO {
  id       String   @id @default(cuid())
  url      String
  legenda  String?
  criadoEm DateTime @default(now())

  diarioId String
  diario   DiarioObra @relation(fields: [diarioId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Orçamentos (propostas por projeto)
// ---------------------------------------------------------------------------

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  APROVADO
  REJEITADO
}

/// Proposta/orçamento de um projeto. O total é a soma dos itens.
model Orcamento {
  id           String          @id @default(cuid())
  titulo       String
  status       StatusOrcamento @default(RASCUNHO)
  observacoes  String?
  validadeDias Int? // validade da proposta, em dias
  criadoEm     DateTime        @default(now())

  organizacaoId String // herdado do projeto (escopo de tenant)

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  itens ItemOrcamento[]

  @@index([organizacaoId])
  @@index([projetoId])
}

/// Linha de um orçamento: descrição, unidade, quantidade × valor unitário.
model ItemOrcamento {
  id            String @id @default(cuid())
  descricao     String
  unidade       String @default("un") // un, m², m³, m, vb, h, kg...
  quantidade    Float  @default(1)
  valorUnitario Float  @default(0)
  ordem         Int    @default(0)

  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Financeiro (orçado × realizado por projeto)
// ---------------------------------------------------------------------------

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum StatusLancamento {
  PREVISTO
  REALIZADO
}

/// Lançamento financeiro de um projeto. PREVISTO = orçado; REALIZADO = efetivado.
model LancamentoFinanceiro {
  id        String           @id @default(cuid())
  descricao String
  tipo      TipoLancamento   @default(DESPESA)
  categoria String? // Material, Mão de obra, Projeto, Impostos, Equipamentos...
  valor     Float
  data      DateTime
  status    StatusLancamento @default(REALIZADO)
  criadoEm  DateTime         @default(now())

  organizacaoId String

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([organizacaoId])
  @@index([projetoId])
}

// ---------------------------------------------------------------------------
// Documentos / Plantas (por projeto)
// ---------------------------------------------------------------------------

enum CategoriaDocumento {
  PLANTA
  CONTRATO
  LICENCA
  ORCAMENTO
  FOTO
  OUTRO
}

/// Arquivo anexado a um projeto (planta, contrato, licença...). Guardado em /public/uploads.
/// Disciplina do projeto (usada nas plantas, p/ compatibilização).
enum Disciplina {
  ARQUITETONICO
  ESTRUTURAL
  ELETRICO
  HIDRAULICO
  CLIMATIZACAO
  INCENDIO
  PAISAGISMO
  INTERIORES
  OUTRO
}

model Documento {
  id        String             @id @default(cuid())
  nome      String
  categoria CategoriaDocumento @default(OUTRO)
  url       String // /uploads/uuid.ext
  mimeType  String
  tamanho   Int // bytes
  criadoEm  DateTime           @default(now())

  // Controle de revisão de pranchas: documentos com a mesma "prancha" são
  // revisões do mesmo desenho; a mais recente é a vigente.
  disciplina Disciplina @default(OUTRO)
  prancha    String? // ex.: "Planta baixa — Térreo"
  revisao    String? // ex.: R00, R01, R02

  /// Opt-in: só aparece no portal do cliente se o escritório liberar explicitamente.
  visivelCliente Boolean @default(false)

  organizacaoId String

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  enviadoPorId String?
  enviadoPor   User?   @relation("DocEnviados", fields: [enviadoPorId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([projetoId])
}

// ---------------------------------------------------------------------------
// Equipe / Mão de obra (profissionais da obra)
// ---------------------------------------------------------------------------

enum TipoCusto {
  DIARIA // valor por dia
  HORA // valor por hora
  EMPREITADA // valor fechado por serviço
  MENSALISTA // salário mensal
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

/// Profissional da obra (empreiteiro, pedreiro, encanador, eletricista...).
/// Cadastro central do escritório; alocado às obras via AlocacaoProjeto.
model Profissional {
  id                String    @id @default(cuid())
  nome              String
  funcao            String // Pedreiro, Eletricista, Empreiteiro, Mestre de obras...
  tipoCusto         TipoCusto @default(DIARIA)
  custoValor        Float? // valor da diária / hora / empreitada / salário
  telefone          String?
  cpf               String?
  email             String?
  endereco          String?
  contatoEmergencia String?
  chavePix          String?
  observacoes       String?
  ativo             Boolean   @default(true)
  criadoEm          DateTime  @default(now())

  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  alocacoes     AlocacaoProjeto[]
  tarefas       TarefaProfissional[]
  subEtapasResp SubEtapa[]           @relation("SubEtapaResp")

  @@index([organizacaoId])
}

/// Alocação de um profissional a uma obra (com a função e o custo acordados ali).
model AlocacaoProjeto {
  id           String    @id @default(cuid())
  funcaoNaObra String? // função específica nesta obra (default: a do profissional)
  tipoCusto    TipoCusto @default(DIARIA)
  custoValor   Float?
  observacoes  String?
  criadoEm     DateTime  @default(now())

  organizacaoId String // herdado do projeto (escopo de tenant)

  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([profissionalId, projetoId])
  @@index([organizacaoId])
  @@index([projetoId])
}

// ---------------------------------------------------------------------------
// Arquitetura: aprovações/licenças e apontamento de horas (honorários)
// ---------------------------------------------------------------------------

enum StatusAprovacao {
  PREPARACAO
  PROTOCOLADO
  EM_ANALISE
  EXIGENCIA
  APROVADO
  INDEFERIDO
}

/// Protocolo em órgão (prefeitura, bombeiros, concessionária, CAU/CREA).
model Aprovacao {
  id              String          @id @default(cuid())
  orgao           String // Prefeitura, Corpo de Bombeiros, CAU/CREA...
  descricao       String // "Aprovação do projeto legal"
  numeroProtocolo String?
  dataProtocolo   DateTime?
  prazo           DateTime? // prazo p/ resposta/exigência
  status          StatusAprovacao @default(PREPARACAO)
  observacoes     String?
  criadoEm        DateTime        @default(now())

  organizacaoId String

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  responsavelId String?
  responsavel   User?   @relation("AprovacaoResp", fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([projetoId])
}

/// Hora de projeto lançada por alguém do escritório (base dos honorários).
model ApontamentoHoras {
  id        String   @id @default(cuid())
  data      DateTime
  horas     Float
  descricao String?
  valorHora Float?
  criadoEm  DateTime @default(now())

  organizacaoId String

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("HorasUser", fields: [userId], references: [id], onDelete: SetNull)

  // Fase do projeto (etapa do cronograma) a que a hora pertence.
  etapaId String?
  etapa   EtapaProjeto? @relation(fields: [etapaId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([projetoId])
}

/// Tarefa de um profissional numa obra (com prazo, status e custo).
model TarefaProfissional {
  id          String       @id @default(cuid())
  titulo      String
  descricao   String?
  status      StatusTarefa @default(PENDENTE)
  prazo       DateTime?
  custo       Float?
  concluidaEm DateTime?
  criadoEm    DateTime     @default(now())

  organizacaoId String

  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  profissionalId String?
  profissional   Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([projetoId])
}
