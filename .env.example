# Copie para .env se rodar fora do Docker. No docker compose, estas variáveis já vêm do compose.

# Banco PostgreSQL
DATABASE_URL="postgresql://obras:obras@localhost:5432/obras?schema=public"

# Segredo do Auth.js (gere um novo com: npx auth secret)
AUTH_SECRET="troque-por-um-segredo-aleatorio"
AUTH_TRUST_HOST=true
